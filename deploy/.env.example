# Switchboard deploy stack — copy to `.env` and edit, then:
#   docker compose --env-file .env -f deploy/docker-compose.yml up -d --build
#
# The stack comes up with ONLY the three "set before first boot" values below.
# Everything else gates a single real-mode feature (see HUMAN_TODO.md); leave a
# variable unset and that feature stays mocked/disabled — the stack still boots.
# Full matrix + notes: deploy/README.md.

# ── Required before first boot ───────────────────────────────────────────────
POSTGRES_PASSWORD=change-me-before-first-boot
# >=32 chars in production (the api refuses to start otherwise). Signs sessions
# AND derives the OAuth-token encryption key — rotating forces mailbox re-auth.
#   generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The API rejects the committed placeholder below; replace it before boot.
SESSION_SECRET=change-me-32-chars-minimum-000000
# Signs one-click unsubscribe tokens (I-SEND-5). Same rules as SESSION_SECRET
# (>=32 chars, api refuses placeholders/empty in production) but MUST be a
# DIFFERENT value — the api no longer falls back to SESSION_SECRET for this.
LIST_UNSUBSCRIBE_SECRET=change-me-32-chars-minimum-111111
# A THIRD secret, GMAIL_PUSH_TOKEN, becomes required before boot as soon as you
# run MOCK_MODE=0 with GOOGLE_CLIENT_ID set. It lives in the Gmail section below.

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
# 1 = every external provider mocked, zero accounts needed. 0 = real mode.
MOCK_MODE=1
PORT=3000
WEB_HTTP_PORT=8080
POSTGRES_USER=switchboard
POSTGRES_DB=switchboard
# DATABASE_URL / REDIS_URL are auto-derived to the in-cluster services.
# Set them ONLY to point at an external Postgres/Redis.
#DATABASE_URL=
#REDIS_URL=
# pino level for the api: fatal|error|warn|info|debug|trace. Default info.
# Container logs rotate at 10 MiB x 5 files per service (compose `logging:`);
# `debug`/`trace` will chew through that window fast.
LOG_LEVEL=info
# Reported as /healthz `version` and as the `release` on captured errors. Set it
# to the deployed git SHA or image tag. Leave COMMENTED if unused — the code
# falls back with `??`, so a blank `APP_VERSION=` line reports version:"" rather
# than "unknown".
#APP_VERSION=

# ── On-disk state (compose sets both + mounts a volume at each) ──────────────
# docker-compose.yml sets these per-service, and `environment:` beats env_file,
# so these lines are commented out deliberately: an active value here would be
# dead config that can drift from the actual mount.
#   IMPORT_STORAGE_DIR → volume `importdata`. Uploaded raw CSVs. MUST survive a
#     restart: POST /imports writes the file and POST /imports/:id/dry-run
#     re-reads it in a separate request, with no re-upload route to recover.
#   TMPDIR → volume `exportdata`. Admin data exports have no env var of their
#     own; they are written under the process temp dir, so TMPDIR is the only
#     lever. Exports land in $TMPDIR/switchboard/exports. There is NO download
#     endpoint yet and nothing prunes them — see README "Admin exports".
#IMPORT_STORAGE_DIR=/var/lib/switchboard/imports
#TMPDIR=/var/lib/switchboard/tmp


# ── SSO (Phase 5) — company IdP, OIDC. Dev-login stub covers until set ───────
# Groups: `sales-crm-users` (login) / `sales-crm-admins` (admin).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Absolute origin the OIDC callback returns to (the web front door).
WEB_ORIGIN=http://localhost:8080
#
# To prove real SSO with NO company account, use the bundled Keycloak
# (`--profile keycloak`, see deploy/KEYCLOAK.md) and set:
#   MOCK_MODE=0
#   OIDC_ISSUER=http://localhost:8081/realms/switchboard
#   OIDC_CLIENT_ID=switchboard
#   OIDC_CLIENT_SECRET=switchboard-dev-secret
# Keycloak admin console creds (change if you expose it):
#KEYCLOAK_ADMIN=admin
#KEYCLOAK_ADMIN_PASSWORD=admin

# ── Real-mode providers ──────────────────────────────────────────────────────
# Gmail two-way sync — THE ONLY real adapter the provider registry builds today.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Default From address / Message-ID domain for the real Gmail adapter. Read only
# when MOCK_MODE=0 AND GOOGLE_CLIENT_ID is set; empty makes sends fail per-send.
GMAIL_SENDER_ADDRESS=
# Shared secret authenticating `POST /wh/gmail` — an internet-facing, otherwise
# UNAUTHENTICATED ingress. Without a token that endpoint accepts any well-formed
# JSON from anyone; this is what keeps it shut. (secret: yes)
#
# REQUIRED when MOCK_MODE=0 AND GOOGLE_CLIENT_ID is set: the api REFUSES TO BOOT
# without it. Unused under MOCK_MODE=1; a Gmail-less real-mode deploy may leave
# it unset. >=32 chars in production, same rules as SESSION_SECRET /
# LIST_UNSUBSCRIBE_SECRET, and like them it must be its own distinct value.
#
# Leave the placeholder EXACTLY as written until you replace it — that literal
# string is blocklisted in apps/api/src/config.ts, so forgetting to change it
# fails closed at boot rather than running open. Your own invented placeholder
# would be silently ACCEPTED; don't substitute one.
#   generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Operator note: create the Google Pub/Sub push subscription with THIS SAME
# token, or every push Google sends is rejected and mailbox sync goes silent.
GMAIL_PUSH_TOKEN=change-me-to-a-random-gmail-push-token
# Public HTTPS origin the proxy forwards to /wh/* (Twilio signs the full URL).
# Also the base URL for one-click unsubscribe links, and the WEB_ORIGIN fallback.
PUBLIC_WEBHOOK_URL=
# Mailbox in the List-Unsubscribe mailto: header (I-SEND-5). Default
# unsubscribe@switchboard.internal is NOT deliverable. Comment it out rather
# than leaving it blank — the fallback is `??`, so an empty line ships an empty
# mailbox in the header.
#UNSUBSCRIBE_MAILBOX=unsubscribe@yourcompany.example

# ── NOT YET WIRED — setting these turns nothing on ───────────────────────────
# Read before you go get an account. `providers/registry.ts` builds the
# telephony / ASR / AI adapters ONLY under MOCK_MODE=1; its real branch
# constructs the Gmail email provider and nothing else. With MOCK_MODE=0:
#   - calling + SMS are NOT mounted, whatever TWILIO_* says;
#   - call transcription is NOT mounted, whatever DEEPGRAM_API_KEY says;
#   - AI summaries / drafting / NL→Smart View are NOT mounted, whatever
#     ANTHROPIC_API_KEY says.
# Kept so the credential names are settled and the switch-on is a registry
# change, not an env archaeology dig. Until then, use MOCK_MODE=1.
# (TWILIO_AUTH_TOKEN / TWILIO_PHONE_NUMBER *are* read by the composition root —
# but only inside the branch that needs a telephony provider to exist, which in
# real mode it does not. Mock mode uses a fixed test token, not this one.)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=

# ── Error tracking (Sentry protocol) — wired and live ────────────────────────
# A parseable DSN makes the api POST captured exceptions there; unset or
# malformed degrades to console logging (never crashes boot). The bundled
# GlitchTip profile below speaks this protocol — use its project DSN.
SENTRY_DSN=

# ── Optional: self-hosted error tracking (profile `glitchtip`) ───────────────
# Required ONLY when you enable that profile; GlitchTip refuses to boot without it.
GLITCHTIP_SECRET_KEY=
GLITCHTIP_DB=glitchtip
GLITCHTIP_DOMAIN=http://localhost:8000
GLITCHTIP_FROM_EMAIL=glitchtip@localhost

# ── Backups ─────────────────────────────────────────────────────────────────
#BACKUP_DIR=
#BACKUP_RETENTION=14
