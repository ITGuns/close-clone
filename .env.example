# Switchboard environment — copy to .env and fill in. PLACEHOLDERS ONLY in this
# file; never commit real secrets (.env is gitignored).
#
# The whole stack brings up under MOCK_MODE=1 with ZERO external accounts: set
# POSTGRES_PASSWORD, SESSION_SECRET and LIST_UNSUBSCRIBE_SECRET (the api refuses
# to boot in production on the committed placeholders), leave the rest, and
# `docker compose up` works — providers are mocked.
#
# Flipping MOCK_MODE=0 enables features PER CREDENTIAL FAMILY: OIDC_* turns on
# SSO (required), GOOGLE_* turns on Gmail sync, TWILIO_* turns on calling+SMS,
# DEEPGRAM_API_KEY + ANTHROPIC_API_KEY together turn on the AI surface. A family
# left wholly unset pauses exactly that feature — the api still boots. A family
# left HALF-set refuses to boot naming the missing keys (see each section).
# Full matrix + which-service/secret table: deploy/README.md.
#
# WHICH FILE DOES THE STACK ACTUALLY READ? Not this one's copy at the repo root.
# `docker compose -f deploy/docker-compose.yml` takes `deploy/` as the project
# directory, so **`deploy/.env`** is what Compose auto-loads for `${VAR}`
# substitution and what the api service's `env_file: .env` resolves to. For a
# containerised bring-up, copy `deploy/.env.example` → `deploy/.env` instead.
# This file is the full variable reference and the env for a NON-compose /
# local `node src/index.ts` run.

# ============================================================================
# Core runtime                                        [service: api · web(build)]
# ============================================================================
# MOCK_MODE=1 → all providers mocked, no accounts needed. 0 → real integrations.
MOCK_MODE=1
NODE_ENV=production
# API listen port INSIDE the container (the compose network). Not host-published.
PORT=3000
# Host port the web front door (nginx) is published on. Company TLS proxy → here.
WEB_HTTP_PORT=8080
# pino level for the api. One of: fatal|error|warn|info|debug|trace. Default info.
LOG_LEVEL=info
# Reported as `version` by GET /healthz and as the `release` on captured errors.
# Set it to the deployed git SHA or image tag. LEAVE IT COMMENTED OUT if unused:
# the code falls back with `??`, so a blank `APP_VERSION=` line is read as the
# empty string and /healthz reports version:"" instead of "unknown".
#APP_VERSION=

# ============================================================================
# On-disk state                                                     [service: api]
# ============================================================================
# Both of these are SET EXPLICITLY by deploy/docker-compose.yml, which also
# mounts a named volume at each path (`importdata`, `exportdata`). Compose's
# per-service `environment:` wins over this env_file, so the lines below are
# commented out on purpose — an active value here would be dead config that can
# silently drift from the actual mount. Set them only for a NON-compose run,
# and only to a directory the api process can write.
#
# IMPORT_STORAGE_DIR — uploaded raw import CSVs. The file MUST outlive a restart:
# POST /imports writes it and POST /imports/:id/dry-run re-reads it in a separate
# request, and there is no re-upload route to recover an orphaned import.
# Code default: /var/lib/switchboard/imports (created + chowned in the image).
#IMPORT_STORAGE_DIR=/var/lib/switchboard/imports
#
# TMPDIR — admin data exports (POST /api/v1/admin/exports) are written under the
# process temp dir. There is no dedicated env var for them, so redirecting TMPDIR
# is the only way to give them a durable home; exports land in
# $TMPDIR/switchboard/exports. There is currently NO download endpoint for a
# finished export, and nothing prunes old ones — see deploy/README.md.
#TMPDIR=/var/lib/switchboard/tmp

# ============================================================================
# Postgres                                                     [service: postgres]
# ============================================================================
# POSTGRES_* seed the postgres container AND compose-derives DATABASE_URL from
# them. Change the password before first boot. (secret: POSTGRES_PASSWORD)
POSTGRES_USER=switchboard
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=switchboard
# DATABASE_URL is set for the api by compose to the in-cluster postgres. Only set
# it here to point at an EXTERNAL/managed Postgres instead of the bundled one.
# DATABASE_URL=postgres://user:pass@db.internal:5432/switchboard

# ============================================================================
# Redis                                                           [service: redis]
# ============================================================================
# Compose sets the api's REDIS_URL to the in-cluster redis. Override only for an
# external Redis.
# REDIS_URL=redis://redis.internal:6379

# ============================================================================
# App secrets                                                       [service: api]
# ============================================================================
# Signs sessions AND derives the encryption key for stored OAuth tokens
# (TokenCipher). Use a long random value; ROTATING IT invalidates linked-mailbox
# tokens (reps must re-auth). (secret: yes) e.g. `openssl rand -hex 32`
# The API rejects this committed placeholder in production; replace it before boot.
SESSION_SECRET=change-me-to-a-64-char-random-hex-string
# Signs one-click List-Unsubscribe tokens (I-SEND-5). MUST be distinct from
# SESSION_SECRET (different purpose, independent rotation). Required before
# first boot in production (>=32 chars): the API rejects this committed
# placeholder, an empty value, and any value under 32 chars. (secret: yes)
# e.g. `openssl rand -hex 32`
LIST_UNSUBSCRIBE_SECRET=change-me-to-a-different-64-char-random-hex

# ============================================================================
# Company IdP / SSO (OIDC)                            [service: api · real mode]
# ============================================================================
# Two role-resolution strategies (apps/api/src/auth/rbac.ts):
#  - GROUPS (Keycloak or any IdP that mints a `groups` claim): membership in
#    `sales-crm-users` → rep, `sales-crm-admins` → admin. Authoritative
#    whenever the ID token carries `groups` at all.
#  - VERIFIED WORKSPACE DOMAIN (Google directly — Google's ID tokens carry NO
#    `groups` claim, ever): set AUTH_ALLOWED_DOMAIN below. Without it, an
#    OIDC_ISSUER of accounts.google.com REFUSES TO BOOT, because every login
#    would otherwise be denied at runtime.
# Dev-login stub covers until this is set. (secret: OIDC_CLIENT_SECRET)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Google-direct SSO: your Workspace domain, bare (e.g. `example.com` — no
# scheme, no @, no path; malformed values refuse the boot). Login then requires
# a VERIFIED email (email_verified=true) whose signed `hd` claim equals this
# domain — personal gmail.com accounts have no `hd` and are refused. Unset ⇒
# groups-only RBAC (the Keycloak path).
AUTH_ALLOWED_DOMAIN=
# Comma-separated admin allow-list for the domain strategy, matched
# case-insensitively against the verified email; everyone else in the domain is
# a rep. Entries must be inside AUTH_ALLOWED_DOMAIN (and require it to be set)
# or the api refuses to boot — a grant that can never match is a typo.
#   e.g. AUTH_ADMIN_EMAILS=alice@example.com, bob@example.com
AUTH_ADMIN_EMAILS=
# Absolute origin of the web front door. The OIDC redirect_uri and the
# post-login redirect are built from it (`${WEB_ORIGIN}/api/v1/auth/callback`).
# Falls back to PUBLIC_WEBHOOK_URL, then to '' — an empty value yields a
# relative redirect_uri the IdP will reject, so set it whenever OIDC_* is set.
WEB_ORIGIN=http://localhost:8080

# ============================================================================
# Gmail two-way sync                                  [service: api · real mode]
# ============================================================================
# Redirect URI (prod): https://<app-url>/api/auth/google/callback. (secret: GOOGLE_CLIENT_SECRET)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Default From address / Message-ID domain for the real Gmail adapter. Read only
# when MOCK_MODE=0 AND GOOGLE_CLIENT_ID is set; empty makes sends fail per-send.
GMAIL_SENDER_ADDRESS=
# Shared secret authenticating `POST /wh/gmail`. This is an INTERNET-FACING,
# otherwise-unauthenticated ingress: without a token the endpoint accepts any
# well-formed JSON from anyone, so the token is what keeps it shut. (secret: yes)
#
# REQUIRED when MOCK_MODE=0 AND GOOGLE_CLIENT_ID is set — the api REFUSES TO
# BOOT without it. Unused under MOCK_MODE=1, and a Gmail-less real-mode deploy
# may leave it unset. In production it must be >=32 chars.
#
# Leave the placeholder EXACTLY as written until you replace it: that literal
# string is blocklisted in apps/api/src/config.ts, so a deploy that forgets to
# change it fails closed at boot instead of running open. Substituting your own
# "obviously fake" placeholder would be silently ACCEPTED — don't.
#   generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Operator note: create the Google Pub/Sub push subscription with THIS SAME
# token, or every push Google sends is rejected and mailbox sync goes silent.
GMAIL_PUSH_TOKEN=change-me-to-a-random-gmail-push-token

# ============================================================================
# Outbound email envelope                                          [service: api]
# ============================================================================
# Mailbox published in the List-Unsubscribe mailto: header (I-SEND-5). Defaults
# to unsubscribe@switchboard.internal, which is NOT deliverable — point it at a
# real monitored mailbox before sending to anyone outside the company.
# Comment it out rather than leaving it blank: the fallback is `??`, so an empty
# `UNSUBSCRIBE_MAILBOX=` line ships a List-Unsubscribe header with no mailbox.
#UNSUBSCRIBE_MAILBOX=unsubscribe@yourcompany.example

# ============================================================================
# Twilio calling + SMS                                [service: api · real mode]
# ============================================================================
# WIRED (2026-07-29): with MOCK_MODE=0, the FULL set — TWILIO_ACCOUNT_SID,
# TWILIO_AUTH_TOKEN, TWILIO_PHONE_NUMBER, plus PUBLIC_WEBHOOK_URL (below) —
# mounts click-to-call + the dialer (POST /api/v1/calls/*), two-way SMS
# (POST /api/v1/sms/send, sequence SMS steps) and the signature-verified
# /wh/twilio/{voice,sms,status} ingress (inbound calls/SMS, STOP opt-outs).
#   - ALL FOUR unset → telephony is simply absent (no routes) and the api boots.
#   - SOME set, some missing → the api REFUSES TO BOOT naming the missing keys:
#     a half-configured Twilio would otherwise mount routes that fail per
#     request, or silently drop STOP ingestion (PUBLIC_WEBHOOK_URL is required
#     because Twilio signs the FULL public URL — without it every inbound
#     webhook fails verification).
# TWILIO_API_KEY_SID/SECRET are OPTIONAL (REST auth via an API key instead of
# the account auth token) but indivisible: set both or neither, one alone
# refuses the boot. Mock mode ignores all of these (fixed test token).
# (secret: TWILIO_AUTH_TOKEN, TWILIO_API_KEY_SECRET)
#
# HONESTY: the Twilio adapter has passed only transport-injected unit tests; it
# has NEVER been exercised against a live Twilio account (HUMAN_TODO.md —
# includes 10DLC registration before real SMS).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=
# ============================================================================
# Deepgram (ASR) + Anthropic (AI)                     [service: api · real mode]
# ============================================================================
# WIRED (2026-07-29): with MOCK_MODE=0, setting BOTH keys mounts /api/v1/ai/*
# (call summaries with confirm-before-commit, email drafting, NL→Smart View).
# Each key alone is valid config for its vendor and never fails the boot, but
# the AI surface needs the PAIR (summaries run ASR→AI) — one without the other
# mounts nothing and the api logs a warning saying so at startup.
# Neither adapter has been exercised against a live vendor account — only
# transport-injected unit tests (HUMAN_TODO.md). (secret: both)
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=

# ============================================================================
# Webhook ingress URL                                 [service: api · real mode]
# ============================================================================
# Public HTTPS origin the company proxy forwards to /wh/* (Twilio + Gmail push).
# Also the base URL for one-click unsubscribe links, and the WEB_ORIGIN fallback.
# REQUIRED whenever any TWILIO_* var is set (the api refuses to boot without it
# — Twilio signs the full public URL, so a wrong/absent origin silently rejects
# every inbound webhook, including STOP opt-outs). A blank line counts as unset.
PUBLIC_WEBHOOK_URL=

# ============================================================================
# Error tracking (Sentry protocol)                                 [service: api]
# ============================================================================
# Wired and live: when set to a parseable DSN the api POSTs captured exceptions
# there; unset (or malformed) degrades to console logging. The bundled GlitchTip
# profile below speaks this protocol — use its project DSN. (secret: yes)
SENTRY_DSN=

# ============================================================================
# GlitchTip error tracking (optional)      [profile: glitchtip — OFF by default]
# ============================================================================
# Enable with `docker compose --profile glitchtip up`. Needs a dedicated DB
# (create it in the bundled postgres or point at an external one). (secret: GLITCHTIP_SECRET_KEY)
GLITCHTIP_SECRET_KEY=
GLITCHTIP_DB=glitchtip
GLITCHTIP_DOMAIN=http://localhost:8000
GLITCHTIP_FROM_EMAIL=glitchtip@localhost

# ============================================================================
# Backups (optional overrides — see deploy/scripts/backup.sh)
# ============================================================================
# BACKUP_DIR=/srv/switchboard/backups
# BACKUP_RETENTION=14
